# Copy to .env or, better, run: python scripts/gen_keys.py   (it writes a real .env + secrets/)
# The app REFUSES TO START if any secret below is missing, a placeholder, or malformed.
DATABASE_URL=sqlite:///./pramaan.db
SECRET_KEY=GENERATE_WITH_scripts/gen_keys.py
MASTER_KEY=BASE64_OF_32_RANDOM_BYTES
MASTER_KEY_VERSION=1
AUDIT_KEY=BASE64_OF_32_RANDOM_BYTES
AUDIT_SIGNING_KEY_PATH=./secrets/audit_signing.pem
# Signed anomaly model written by scripts/train_anomaly.py (rules-only mode if it is missing).
ANOMALY_MODEL_PATH=./models/iforest.joblib
ACCESS_TOKEN_MINUTES=30
PBKDF2_ITERATIONS=600000
STORAGE_DIR=./storage
ANCHOR_FILE=./storage/anchors.jsonl
AUDIT_CHECKPOINT_EVERY=50
RISK_THRESHOLD=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MAX_FAILED_UNLOCKS=5
PIN_STEP_SECONDS=120
# Demo/testing only: ISO timestamp such as 2026-10-31T09:00:00Z, or leave empty
FROZEN_TIME=
DEBUG=false
# Dev only (Vite). Production is same-origin.
CORS_ORIGINS=http://localhost:5173
# Empty = trust no forwarded-IP headers
TRUSTED_PROXY_IPS=
# Set true when served over TLS
COOKIE_SECURE=false
# Rate limits (per minute). Raise LOGIN_RATE_PER_MINUTE if you script many sign-ins from one machine.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_PER_MINUTE=5
VERIFY_RATE_PER_MINUTE=30
SIGNUP_RATE_PER_MINUTE=10
